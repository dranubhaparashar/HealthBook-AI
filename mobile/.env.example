# Environment selection: local | staging | production (default local). Never hardcode localhost into a production build.
EXPO_PUBLIC_ENV=local
# API origin per environment (the build picks the one matching EXPO_PUBLIC_ENV; EXPO_PUBLIC_API_URL overrides all)
EXPO_PUBLIC_API_URL_LOCAL=http://10.0.2.2:8000
EXPO_PUBLIC_API_URL_STAGING=https://your-staging-api.onrender.com
EXPO_PUBLIC_API_URL_PRODUCTION=https://your-api.onrender.com
# Where doctor.html is served (Firebase Hosting site in production). Defaults to the API origin.
EXPO_PUBLIC_WEB_ORIGIN=https://<firebase-project>.web.app
# Required for remote push; obtain the UUID from your Expo EAS project.
EXPO_PUBLIC_EAS_PROJECT_ID=
