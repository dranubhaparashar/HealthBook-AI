{
  "hosting": {
    "public": "web",
    "ignore": ["**/.*", "**/node_modules/**", "**/*.map"],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "no-referrer"},
          {"key": "X-Frame-Options", "value": "DENY"},
          {"key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()"},
          {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
          {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://your-api.onrender.com; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
        ]
      },
      {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/config.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
