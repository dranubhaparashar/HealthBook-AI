# LOCAL-ONLY by default. Never expose directly to the public internet.
BABYCARE_DATA_DIR=./private_data
# For deployed systems use a secrets manager and backed-up encryption keys.
# BABYCARE_FERNET_KEY=<base64 Fernet key>
# BABYCARE_CORS_ORIGINS=http://localhost:19006,http://localhost:8081
BABYCARE_ENV=development
# DATABASE_URL=postgresql+psycopg://babycare:URL_ENCODED_PASSWORD@localhost/babycare
# POSTGRES_PASSWORD=GENERATE_A_STRONG_UNIQUE_PASSWORD
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Browser cookie is Secure in production; serve through HTTPS.
# Generate separate keys with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BABYCARE_BACKUP_KEY=SEPARATE_BACKUP_ENCRYPTION_KEY
BABYCARE_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=YOUR_SERVER_EXPO_TOKEN
# Optional HTTPS OpenAI-compatible vision chat-completions endpoint (exact URL).
# No patient document is sent without per-document guardian consent in the UI.
BABYCARE_VISION_URL=
BABYCARE_VISION_MODEL=
BABYCARE_AI_KEY=

# ---- Zero-cost cloud deployment (Render free + Supabase free + Firebase Hosting Spark); see the Deployment and CI/CD page in the project wiki
# BABYCARE_STORAGE=supabase                 # local (default) | supabase  (production requires supabase or BABYCARE_ALLOW_LOCAL_STORAGE=true)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=                # backend-only secret; never ship to web or mobile
# SUPABASE_STORAGE_BUCKET=medical-documents # private bucket, created automatically
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres   # Session pooler (IPv4)
# BABYCARE_SCHEDULER_KEY=                   # >=24 random chars; X-Scheduler-Key header used by cron-job.org / pg_cron to wake the API
# BABYCARE_VAPID_PUBLIC_KEY=                # python -m api.push_web generate
# BABYCARE_VAPID_PRIVATE_KEY=
# BABYCARE_VAPID_CONTACT=mailto:you@example.com
# BABYCARE_BACKUP_KEY=                      # separate Fernet key for scripts/cloud_backup.py archives; keep outside the backup folder
# PSYCOPG_IMPL=python                       # Windows only, if Application Control blocks psycopg's DLL; needs a libpq.dll on PATH
